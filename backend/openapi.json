          },
          "message": {
            "maxLength": 1000,
            "title": "Message",
            "type": "string"
          },
          "path": {
            "maxLength": 500,
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "message",
          "path"
        ],
        "title": "ClientEvent",
        "type": "object"
      },
