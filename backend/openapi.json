          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "timeframe": {
            "title": "Timeframe",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "timeframe",
          "candles",
          "next_cursor",
          "has_more"
