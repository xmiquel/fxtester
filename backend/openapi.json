          "type": {
            "const": "service_unavailable",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "detail"
        ],
        "title": "ServiceUnavailable",
        "type": "object"
      },
      "SymbolCatalog": {
        "properties": {
          "symbols": {
